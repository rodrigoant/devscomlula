{
  "name": "devscomlula",
  "version": "0.0.3",
  "description": "Componente React de faixa e fita em apoio à democracia #devscomlula",
  "keywords": [
    "react",
    "banner",
    "devscomlula",
    "ribbon",
    "nextjs"
  ],
  "author": "Rodrigo Antunes",
  "license": "MIT",
  "homepage": "http://lula.rodrigoantunes.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigoant/devscomlula"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.0.0"
  }
}
