{
  "name": "devscomlula-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "http://lula.rodrigoantunes.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigoant/devscomlula"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pkg": "npm --workspace=packages/devscomlula run build",
